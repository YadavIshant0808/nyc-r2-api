# Clerk Dashboard -> API Keys -> "Frontend API URL" (no trailing slash)
CLERK_ISSUER=https://your-app-name.clerk.accounts.dev

# Clerk Dashboard -> API Keys -> Secret key
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxx

# Comma-separated list of exact browser origins (no paths or trailing slashes)
CORS_ORIGINS=http://localhost:3000,https://nyc-r2-web.vercel.app

# Postgres connection string. Local dev example (docker-compose):
DATABASE_URL=postgresql://appuser:apppassword@localhost:5432/appdb
# On GKE this points at the Cloud SQL Auth Proxy sidecar instead - see
# README.md - typically: postgresql://appuser:PASSWORD@127.0.0.1:5432/appdb

# Optional pool tuning - defaults are fine for most cases; see the
# "connections vs replicas" note in README.md before raising these.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_ECHO=false
